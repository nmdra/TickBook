# User Service Configuration

# Server
PORT=3002

# PostgreSQL / Neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Apache Kafka
KAFKA_BROKERS=localhost:9092

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
INTERNAL_SERVICE_TOKEN=replace-with-strong-shared-token

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/api/users/auth/google/callback
FRONTEND_SUCCESS_URL=http://localhost:5173/auth/google/success
FRONTEND_DASHBOARD_URL=http://localhost:5173/

# Hosted Azure Container Apps example:
# GOOGLE_REDIRECT_URI=https://nginx-gateway.bravemoss-36d38df2.eastus.azurecontainerapps.io/api/users/auth/google/callback
# FRONTEND_SUCCESS_URL=<YOUR_FRONTEND_HOST>/auth/google/success
# FRONTEND_DASHBOARD_URL=<YOUR_FRONTEND_HOST>/

# Upstream services used by GET /api/users/profile
BOOKING_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
